{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudexit.org/schema/vendor-assessment.v0.1.json",
  "title": "Cloud Exit provider assessment",
  "type": "object",
  "required": [
    "kind",
    "publish",
    "provider",
    "product",
    "region",
    "plan",
    "standard_version",
    "reviewed",
    "expires",
    "results",
    "evidence"
  ],
  "properties": {
    "kind": { "const": "assessment" },
    "publish": { "type": "boolean" },
    "provider": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "minLength": 1 },
    "plan": { "type": "string", "minLength": 1 },
    "standard_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+" },
    "reviewed": { "type": "string", "format": "date" },
    "expires": { "type": "string", "format": "date" },
    "record_url": { "type": "string" },
    "results": {
      "type": "object",
      "required": ["c1", "c2", "c3", "c4", "c5"],
      "additionalProperties": false,
      "properties": {
        "c1": { "$ref": "#/$defs/state" },
        "c2": { "$ref": "#/$defs/state" },
        "c3": { "$ref": "#/$defs/state" },
        "c4": { "$ref": "#/$defs/state" },
        "c5": { "$ref": "#/$defs/state" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "url", "collected"],
        "properties": {
          "criterion": { "enum": ["c1", "c2", "c3", "c4", "c5"] },
          "url": { "type": "string", "format": "uri" },
          "collected": { "type": "string", "format": "date" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "state": {
      "enum": ["pass", "partial", "fail", "unknown", "stale", "withdrawn"]
    }
  }
}

